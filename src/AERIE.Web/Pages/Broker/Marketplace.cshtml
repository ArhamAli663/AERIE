@page
@model AERIE.Web.Pages.Broker.MarketplaceModel
@{
    ViewData["Title"] = "Live Broiler Marketplace";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <div>
        <h2 style="font-weight: 700; letter-spacing: -0.5px; margin-bottom: 0.25rem;">Live Broiler Trading Marketplace</h2>
        <p style="color: var(--color-text-muted); font-size: 0.95rem; margin: 0;">
            Browse verified farm-ready broiler batches across regions and submit competitive purchase proposals.
        </p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success" style="border-radius: var(--radius-md); font-size: 0.9rem;">
        @Model.StatusMessage
    </div>
}

<!-- Search & City Filter Bar -->
<div class="panel-card" style="padding: 1rem 1.5rem; margin-bottom: 1.5rem;">
    <form method="get" style="display: flex; gap: 1rem; align-items: center;">
        <div style="flex: 1;">
            <input type="text" name="city" value="@Model.SelectedCity" class="form-control" placeholder="Filter by City (e.g. Lahore, Faisalabad, Rawalpindi)..." />
        </div>
        <button type="submit" class="btn-stitch-primary">Filter Listings</button>
        @if (!string.IsNullOrEmpty(Model.SelectedCity))
        {
            <a asp-page="/Broker/Marketplace" class="btn-stitch-secondary">Clear</a>
        }
    </form>
</div>

<!-- Marketplace Listings Grid -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 1.5rem;">
    @foreach (var l in Model.Listings)
    {
        <div class="stat-card" style="display: flex; flex-direction: column; justify-content: space-between; border-top: 4px solid var(--color-primary);">
            <div>
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
                    <div>
                        <span class="badge badge-success">Available for Bidding</span>
                        <h4 style="margin: 0.5rem 0 0.25rem 0; font-size: 1.15rem; font-weight: 700;">@l.Title</h4>
                        <div style="font-size: 0.8rem; color: var(--color-text-muted);">
                            📍 @l.LocationCity • Batch @l.BatchCode (@l.BreedName)
                        </div>
                    </div>
                </div>

                <div style="background: var(--color-surface-hover); padding: 1rem; border-radius: var(--radius-md); margin: 1rem 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
                    <div>
                        <div style="font-size: 0.75rem; color: var(--color-text-muted); text-transform: uppercase;">Available Birds</div>
                        <div style="font-size: 1.25rem; font-weight: 700; color: var(--color-primary-dark);">@l.QuantityAvailable.ToString("N0")</div>
                    </div>
                    <div>
                        <div style="font-size: 0.75rem; color: var(--color-text-muted); text-transform: uppercase;">Asking Rate</div>
                        <div style="font-size: 1.25rem; font-weight: 700; color: var(--color-success);">Rs. @l.AskingPricePerKg / kg</div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(l.Notes))
                {
                    <p style="font-size: 0.8rem; color: var(--color-text-muted); margin-bottom: 1rem;">
                        <em>"@l.Notes"</em>
                    </p>
                }
            </div>

            <div>
                <button type="button" class="btn-stitch-primary" style="width: 100%; justify-content: center;"
                        data-bs-toggle="modal" data-bs-target="#proposalModal"
                        onclick="openProposalModal('@l.Id', '@l.Title', @l.QuantityAvailable, @l.AskingPricePerKg)">
                    Submit Purchase Bid / Proposal
                </button>
            </div>
        </div>
    }
</div>

@if (!Model.Listings.Any())
{
    <div class="panel-card" style="text-align: center; padding: 3rem;">
        <h4 style="font-weight: 600; color: var(--color-text-muted);">No Published Listings Found</h4>
        <p style="font-size: 0.9rem; color: var(--color-text-subtle);">
            Farmers publish batches as soon as flocks reach market harvest readiness.
        </p>
    </div>
}

<!-- Modal: Submit Purchase Proposal -->
<div class="modal fade" id="proposalModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius: var(--radius-lg);">
            <form method="post" asp-page-handler="SubmitProposal">
                <input type="hidden" id="proposalListingId" name="ListingId" />
                <div class="modal-header">
                    <h5 class="modal-title" style="font-weight: 600;">Create Purchase Proposal</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" style="display: flex; flex-direction: column; gap: 1rem;">
                    <div>
                        <div style="font-size: 0.85rem; color: var(--color-text-muted);">Target Listing</div>
                        <strong id="proposalListingTitle"></strong>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                        <div>
                            <label class="form-label" style="font-size: 0.85rem; font-weight: 500;">Quantity Requested (Birds)</label>
                            <input type="number" id="proposalQuantity" name="QuantityRequested" class="form-control" required />
                            <div style="font-size: 0.75rem; color: var(--color-text-muted);">Max: <span id="maxAvailableQuantity"></span></div>
                        </div>
                        <div>
                            <label class="form-label" style="font-size: 0.85rem; font-weight: 500;">Offered Price / Kg (Rs.)</label>
                            <input type="number" step="0.01" id="proposalOfferedPrice" name="OfferedPricePerKg" class="form-control" required />
                        </div>
                    </div>

                    <div>
                        <label class="form-label" style="font-size: 0.85rem; font-weight: 500;">Transport Arrangements</label>
                        <input type="text" name="TransportArrangement" class="form-control" placeholder="e.g. Buyer provides 2 Mazda trucks, pickup at 6 AM" />
                    </div>

                    <div>
                        <label class="form-label" style="font-size: 0.85rem; font-weight: 500;">Additional Terms / Notes</label>
                        <textarea name="Notes" class="form-control" rows="2" placeholder="e.g. Delivery to Lahore wholesale mandi, payment via cheque/online transfer"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-stitch-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-stitch-primary">Send Proposal to Farmer</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openProposalModal(listingId, title, available, asking) {
        document.getElementById('proposalListingId').value = listingId;
        document.getElementById('proposalListingTitle').innerText = title;
        document.getElementById('proposalQuantity').value = available;
        document.getElementById('maxAvailableQuantity').innerText = available + ' birds';
        document.getElementById('proposalOfferedPrice').value = asking;
    }
</script>
}
