@page
@model AERIE.Web.Pages.Broker.MarketComparisonModel
@{
    ViewData["Title"] = "Inter-Market Price Spread & Arbitrage";
    var c = Model.Comparison;
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="page-title mb-1">Inter-Market Arbitrage & Profitability Analysis</h2>
        <p class="text-muted mb-0">Evaluate regional poultry price differences, transport costs, and estimated trading net margins.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/Broker/MarketRates" class="btn btn-outline-secondary btn-sm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
            Live Mandi Rates
        </a>
        <a asp-page="/Broker/Marketplace" class="btn btn-primary btn-sm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg>
            Find Source Listings
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        @Model.ErrorMessage
    </div>
}

<div class="row g-4">
    <!-- Calculator Form -->
    <div class="col-lg-4">
        <div class="panel-card">
            <div class="panel-card-header">
                <h5 class="panel-card-title mb-0">Trade Parameters</h5>
                <small class="text-muted">Select origin, destination and load</small>
            </div>
            <div class="p-3">
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Source Market (Origin City)</label>
                        <select name="SourceCity" class="form-select" asp-for="SourceCity">
                            <option value="Faisalabad">Faisalabad (Surplus Production)</option>
                            <option value="Sargodha">Sargodha</option>
                            <option value="Gujranwala">Gujranwala</option>
                            <option value="Sahiwal">Sahiwal</option>
                            <option value="Multan">Multan</option>
                            <option value="Lahore">Lahore</option>
                            <option value="Rawalpindi">Rawalpindi</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Destination Market (Demand City)</label>
                        <select name="DestinationCity" class="form-select" asp-for="DestinationCity">
                            <option value="Lahore">Lahore (High Consumer Demand)</option>
                            <option value="Rawalpindi">Rawalpindi / Islamabad</option>
                            <option value="Faisalabad">Faisalabad</option>
                            <option value="Gujranwala">Gujranwala</option>
                            <option value="Multan">Multan</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Proposed Trading Load (Kg)</label>
                        <input type="number" step="100" name="QuantityKg" class="form-control" asp-for="QuantityKg" required />
                        <small class="text-muted">Standard Shehzore truck ~ 2,500-3,500 kg; 6-wheeler ~ 5,000-8,000 kg</small>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Estimated Freight Cost (Rs / kg)</label>
                        <input type="number" step="0.25" name="EstimatedFreightPerKg" class="form-control" asp-for="EstimatedFreightPerKg" />
                        <small class="text-muted">Includes diesel, driver, tolls, and loading crates</small>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        Calculate Arbitrage & Margin
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Results Panel -->
    <div class="col-lg-8">
        @if (c != null)
        {
            <div class="panel-card mb-4">
                <div class="panel-card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="panel-card-title mb-0">Market Spread: @c.SourceCity &rarr; @c.DestinationCity</h5>
                        <small class="text-muted">Analysis based on current database mandi quotations</small>
                    </div>
                    <span class="badge @(c.NetArbitrageMarginPerKg > 0 ? "bg-success" : "bg-danger")" style="font-size: 0.9rem;">
                        @(c.NetArbitrageMarginPerKg > 0 ? "Viable Arbitrage Opportunity" : "Negative / Zero Margin Trade")
                    </span>
                </div>
                <div class="p-4">
                    <!-- Comparison Overview Cards -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded text-center border">
                                <div class="text-muted small">Origin Price (@c.SourceCity)</div>
                                <div class="fs-4 fw-bold">Rs. @c.SourcePricePerKg.ToString("N2") <span class="fs-6 font-monospace">/kg</span></div>
                                <div class="badge bg-secondary-subtle text-secondary border mt-1">@c.SourceFreshness</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded text-center border">
                                <div class="text-muted small">Destination Price (@c.DestinationCity)</div>
                                <div class="fs-4 fw-bold text-primary">Rs. @c.DestinationPricePerKg.ToString("N2") <span class="fs-6 font-monospace">/kg</span></div>
                                <div class="badge bg-primary-subtle text-primary border mt-1">@c.DestinationFreshness</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded text-center border">
                                <div class="text-muted small">Gross Price Spread</div>
                                <div class="fs-4 fw-bold @(c.PriceSpreadPerKg > 0 ? "text-success" : "text-danger")">
                                    @(c.PriceSpreadPerKg > 0 ? "+" : "")Rs. @c.PriceSpreadPerKg.ToString("N2") <span class="fs-6 font-monospace">/kg</span>
                                </div>
                                <div class="small text-muted mt-1">Before transport expenses</div>
                            </div>
                        </div>
                    </div>

                    <!-- Financial Breakdown Table -->
                    <div class="table-responsive mb-4">
                        <table class="table table-bordered mb-0">
                            <tbody>
                                <tr>
                                    <td class="fw-semibold">Proposed Trading Quantity</td>
                                    <td class="text-end">@c.QuantityKg.ToString("N0") kg</td>
                                </tr>
                                <tr>
                                    <td>Gross Revenue at Destination Rate</td>
                                    <td class="text-end">Rs. @((c.DestinationPricePerKg * c.QuantityKg).ToString("N0"))</td>
                                </tr>
                                <tr>
                                    <td>Source Acquisition Cost</td>
                                    <td class="text-end text-muted">- Rs. @((c.SourcePricePerKg * c.QuantityKg).ToString("N0"))</td>
                                </tr>
                                <tr>
                                    <td>Gross Spread Total</td>
                                    <td class="text-end fw-semibold">Rs. @((c.PriceSpreadPerKg * c.QuantityKg).ToString("N0"))</td>
                                </tr>
                                <tr>
                                    <td>Estimated Freight & Transport Deductions (@c.EstimatedFreightPerKg.ToString("N2") Rs/kg)</td>
                                    <td class="text-end text-danger">- Rs. @((c.EstimatedFreightPerKg * c.QuantityKg).ToString("N0"))</td>
                                </tr>
                                <tr class="table-light">
                                    <td class="fw-bold fs-5">Estimated Net Arbitrage Profit</td>
                                    <td class="text-end fw-bold fs-5 @(c.EstimatedTotalProfit > 0 ? "text-success" : "text-danger")">
                                        Rs. @c.EstimatedTotalProfit.ToString("N0")
                                        <div class="small fw-normal text-muted">(@c.NetArbitrageMarginPerKg.ToString("N2") Rs/kg net margin)</div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Mandatory Domain Transparency Notice -->
                    <div class="alert alert-warning mb-0 border-warning-subtle" role="alert">
                        <div class="d-flex align-items-center">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-2 flex-shrink-0"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                            <div>
                                <strong>Transparency & Decision Support Notice:</strong> @c.Disclaimer
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="panel-card text-center py-5">
                <p class="text-muted mb-0">Select source and destination markets and click "Calculate Arbitrage" to see potential spread.</p>
            </div>
        }
    </div>
</div>
