@page
@model AERIE.Web.Pages.Broker.MarketRatesModel
@{
    ViewData["Title"] = "Live Market Rates & Mandi Rates";
    var prices = Model.MarketPrices;
    var regions = new[] { "All", "Lahore", "Faisalabad", "Rawalpindi", "Multan", "Gujranwala", "Sargodha", "Sahiwal" };
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="page-title mb-1">Live Mandi Market Rates</h2>
        <p class="text-muted mb-0">Authorized city and wholesale market rates across Punjab & National trading centers.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/Broker/MarketComparison" class="btn btn-outline-primary btn-sm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
            Inter-Market Arbitrage
        </a>
        <form method="post" asp-page-handler="RefreshDailyRates" class="d-inline">
            <button type="submit" class="btn btn-outline-success btn-sm px-3 shadow-sm d-flex align-items-center gap-1" title="Simulates and records today's automated daily price fluctuation across all 26 cities">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                <span>🔄 Auto-Update Today's Rates (روزانہ خودکار ریٹ)</span>
            </button>
        </form>
        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#recordRateModal">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Record Mandi Rate
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Automated Daily Rates Engine Status Banner -->
<div class="card border-0 shadow-sm rounded-3 p-3 mb-4 text-white" style="background: linear-gradient(135deg, #065f46 0%, #047857 50%, #059669 100%);">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-white bg-opacity-25 rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            </div>
            <div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning text-dark fw-bold px-2 py-1">AUTOMATED DAILY ENGINE</span>
                    <span class="small opacity-90 text-light">Official Morning Mandi Bulletin Synchronizer</span>
                </div>
                <div class="fw-bold fs-5 mt-1">
                    Today's Official Mandi Date: @DateTime.UtcNow.ToString("dddd, dd MMMM yyyy")
                </div>
                <small class="opacity-75">All Pakistan poultry market rates automatically fluctuate daily according to district supply, demand cycles, and regional freight factors.</small>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <form method="post" asp-page-handler="RefreshDailyRates" class="d-inline">
                <button type="submit" class="btn btn-light btn-sm fw-bold px-3 py-2 shadow-sm d-flex align-items-center gap-2 text-success">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                    <span>Run Today's Price Sync (آج کا ریٹ اپڈیٹ)</span>
                </button>
            </form>
        </div>
    </div>
</div>

<!-- Region Filter Pills -->
<div class="d-flex gap-2 overflow-auto mb-4 pb-2">
    @foreach (var r in regions)
    {
        var isActive = (r == "All" && string.IsNullOrEmpty(Model.SelectedRegion)) || (r == Model.SelectedRegion);
        <a asp-page="/Broker/MarketRates" asp-route-selectedRegion="@(r == "All" ? "" : r)"
           class="btn btn-sm @(isActive ? "btn-primary" : "btn-outline-secondary") rounded-pill px-3">
            @r
        </a>
    }
</div>

<!-- Rates Table Card -->
<div class="panel-card">
    <div class="panel-card-header d-flex justify-content-between align-items-center">
        <div>
            <h5 class="panel-card-title mb-0">Recorded Mandi Rates</h5>
            <small class="text-muted">Live broiler rates per kg, cull birds, and day-old chicks (DOC)</small>
        </div>
        <span class="badge bg-light text-muted border">Real-Time Sync Active</span>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Region / City</th>
                    <th>Market (Mandi)</th>
                    <th>Live Broiler (Rs/kg)</th>
                    <th>Previous (Rs/kg)</th>
                    <th>Daily Change</th>
                    <th>Cull Rate</th>
                    <th>DOC Rate</th>
                    <th>Date & Freshness</th>
                    <th>Verification</th>
                </tr>
            </thead>
            <tbody>
                @if (prices.Any())
                {
                    @foreach (var p in prices)
                    {
                        var diff = p.PreviousRatePerKg.HasValue ? p.BroilerRatePerKg - p.PreviousRatePerKg.Value : 0;
                        var isFresh = p.PriceDate >= today;
                        <tr>
                            <td><strong>@p.Region</strong></td>
                            <td>@(p.MarketName ?? "Main Mandi")</td>
                            <td>
                                <span class="fw-bold" style="font-size: 1.05rem;">Rs. @p.BroilerRatePerKg.ToString("N2")</span>
                            </td>
                            <td class="text-muted">
                                @(p.PreviousRatePerKg.HasValue ? $"Rs. {p.PreviousRatePerKg.Value:N2}" : "—")
                            </td>
                            <td>
                                @if (diff != 0)
                                {
                                    <span class="badge @(diff > 0 ? "bg-success" : "bg-danger")">
                                        @(diff > 0 ? "+" : "")@diff.ToString("N2")
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted">0.00</span>
                                }
                            </td>
                            <td>Rs. @p.CullRatePerKg.ToString("N2")/kg</td>
                            <td>Rs. @p.DayOldChickRate.ToString("N2")/chick</td>
                            <td>
                                <div>@p.PriceDate.ToString("dd MMM yyyy")</div>
                                <small class="@(isFresh ? "text-success" : "text-warning")">
                                    @(isFresh ? "Today's Verified Rate" : "Previous Day / Stale")
                                </small>
                            </td>
                            <td>
                                @if (p.IsVerified)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                        Verified
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Unverified</span>
                                }
                                @if (!string.IsNullOrEmpty(p.Source))
                                {
                                    <div><small class="text-muted">@p.Source</small></div>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-5">
                            No market rates found for the selected region. Click "Record Mandi Rate" to enter authorized rates.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Record / Correct Mandi Rate -->
<div class="modal fade" id="recordRateModal" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="RecordRate">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Record / Publish Mandi Rate</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">City / Region *</label>
                        <input type="text" name="region" class="form-control" placeholder="e.g. Lahore, Faisalabad, Rawalpindi" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Wholesale Mandi Name</label>
                        <input type="text" name="marketName" class="form-control" value="Main Wholesale Mandi" />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label">Live Broiler Rate (Rs/kg) *</label>
                            <input type="number" step="0.5" name="broilerRatePerKg" class="form-control" placeholder="e.g. 385.00" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Cull Bird Rate (Rs/kg)</label>
                            <input type="number" step="0.5" name="cullRatePerKg" class="form-control" value="240.00" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Day-Old Chick Rate (Rs/chick)</label>
                        <input type="number" step="1" name="dayOldChickRate" class="form-control" value="65.00" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Data Source / Verification Reference</label>
                        <input type="text" name="source" class="form-control" placeholder="e.g. Lahore Poultry Association Daily Bulletin" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Publish Rate & Broadcast</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        // Connect to AERIE SignalR Hub for real-time market updates
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/aerie")
            .withAutomaticReconnect()
            .build();

        connection.on("MarketPriceUpdated", function (data) {
            console.log("Real-time market rate updated:", data);
            // Reload or flash update
            const toast = document.createElement("div");
            toast.className = "alert alert-info position-fixed bottom-0 end-0 m-3 shadow";
            toast.style.zIndex = "9999";
            toast.innerHTML = `<strong>Live Rate Broadcast:</strong> New rate for ${data.region || 'market'} received. <a href="javascript:location.reload()" class="alert-link">Refresh to view</a>`;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 8000);
        });

        connection.start().catch(err => console.log("SignalR connection notice:", err));
    </script>
}
