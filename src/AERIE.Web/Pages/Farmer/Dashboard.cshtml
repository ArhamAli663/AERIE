@page
@model AERIE.Web.Pages.Farmer.DashboardModel
@{
    ViewData["Title"] = "Farmer Production Dashboard";
    var s = Model.Summary;
}

<div class="content-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h1 class="h3 fw-bold text-dark mb-0">Farmer Production Dashboard</h1>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">Live Database</span>
        </div>
        <p class="text-muted small mb-0 mt-1">Multi-farm flock tracking, daily consumption logs, mortality thresholds & broker listings.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/Farmer/Batches" class="btn btn-outline-primary btn-sm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path></svg>
            Manage Batches
        </a>
        <button type="button" class="btn btn-success btn-sm text-white" data-bs-toggle="modal" data-bs-target="#quickLogModal">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Record Today's Observation
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
        <strong>Success:</strong> @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
        <strong>Error:</strong> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (s != null)
{
    @if (s.TotalFarms == 0 || !s.Batches.Any())
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4" style="background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%); border-left: 5px solid #10b981 !important;">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div style="font-size: 2.2rem;">🌱</div>
                    <div>
                        <h5 class="fw-bold text-success mb-1">Welcome to Your Clean Farm Workspace!</h5>
                        <p class="text-muted small mb-0">Your account starts fresh with 0 birds and 0 batches. You have complete private isolation — no other farmer or broker can see your records.</p>
                    </div>
                </div>
                <div class="row g-3 pt-2">
                    <div class="col-md-4">
                        <div class="p-3 bg-white rounded-3 border shadow-xs h-100">
                            <div class="badge bg-success-subtle text-success mb-2">Step 1</div>
                            <h6 class="fw-bold text-dark">Register Your Farm & Sheds</h6>
                            <p class="small text-muted mb-3">Define your poultry farm location, environment-controlled or open sheds, and capacity.</p>
                            <a asp-page="/Farmer/Farms" class="btn btn-sm btn-outline-success w-100">Setup Farm & Sheds &rarr;</a>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-white rounded-3 border shadow-xs h-100">
                            <div class="badge bg-primary-subtle text-primary mb-2">Step 2</div>
                            <h6 class="fw-bold text-dark">Place Chicks & Flock Batch</h6>
                            <p class="small text-muted mb-3">Record chick placement date, breed (Cobb 500 / Ross 308), count, and chick cost.</p>
                            <a asp-page="/Farmer/Batches" class="btn btn-sm btn-outline-primary w-100">Place Flock Batch &rarr;</a>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-white rounded-3 border shadow-xs h-100">
                            <div class="badge bg-info-subtle text-info-emphasis mb-2">Step 3</div>
                            <h6 class="fw-bold text-dark">Track Daily Production & Sell</h6>
                            <p class="small text-muted mb-3">Log daily feed & water, track mortality, monitor FCR, and list ready birds on the marketplace.</p>
                            <a asp-page="/Farmer/Listings" class="btn btn-sm btn-outline-info w-100">Marketplace Listings &rarr;</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Top 4 Primary Operational Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Live Bird Inventory</span>
                    <span class="badge bg-primary text-white rounded-pill">@s.ActiveBatchesCount Batches</span>
                </div>
                <div class="h2 fw-bold text-primary mb-1">@s.CurrentLiveBirdCount.ToString("N0")</div>
                <div class="small text-muted">
                    Placed: <strong>@s.TotalChicksPlaced.ToString("N0")</strong> birds across <strong>@s.TotalHouses</strong> sheds
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Mortality Tracker</span>
                    <span class="badge @(s.CumulativeMortalityPct > 5m ? "bg-danger" : "bg-warning-subtle text-dark")">@s.CumulativeMortalityPct.ToString("F1")% Overall</span>
                </div>
                <div class="h2 fw-bold @(s.TodayMortality > 0 ? "text-danger" : "text-dark") mb-1">@s.TodayMortality.ToString("N0") <span class="fs-6 fw-normal text-muted">today</span></div>
                <div class="small text-muted">
                    Cumulative dead: <strong>@s.CumulativeMortality.ToString("N0")</strong> birds
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Feed Consumption</span>
                    <span class="badge bg-info-subtle text-info-emphasis">30-Day: @s.FeedConsumedPeriodKg.ToString("N0") kg</span>
                </div>
                <div class="h2 fw-bold text-dark mb-1">@s.FeedConsumedTodayKg.ToString("N1") <span class="fs-6 fw-normal text-muted">kg today</span></div>
                <div class="small text-muted">
                    Water: <strong>@s.WaterConsumedTodayLiters.ToString("N0") L</strong> today
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Market Readiness</span>
                    <span class="badge bg-success text-white">@s.SaleReadyBirdsCount Ready</span>
                </div>
                <div class="h2 fw-bold text-success mb-1">@s.UncommittedAvailableBirdsCount.ToString("N0") <span class="fs-6 fw-normal text-muted">avail</span></div>
                <div class="small text-muted">
                    Reserved in deals: <strong>@s.ReservedBirdsCount.ToString("N0")</strong> | Bids: <strong>@s.PendingBrokerProposalsCount</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Health Alerts & Broiler Milestones Row -->
    <div class="row g-3 mb-4">
        <!-- Mortality Threshold Alerts -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <span class="p-1 rounded bg-danger-subtle text-danger">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                        </span>
                        <h2 class="h6 fw-bold mb-0">Mortality & Health Alerts</h2>
                    </div>
                    <span class="badge bg-secondary-subtle text-dark">Threshold: 1.5% / Day</span>
                </div>
                <div class="card-body p-3">
                    @if (s.Alerts.Any())
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var alert in s.Alerts)
                            {
                                <div class="p-3 rounded-2 border border-danger-subtle bg-danger-subtle bg-opacity-25">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <strong class="text-danger">@alert.BatchCode (@alert.HouseName)</strong>
                                        <span class="badge bg-danger text-white">@alert.MortalityPct% spike</span>
                                    </div>
                                    <p class="small text-dark mb-1">@alert.TriggerReason</p>
                                    <span class="small text-muted">Recorded Date: @alert.Date.ToString("yyyy-MM-dd") | Dead: @alert.DailyMortality birds</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <div class="text-success mb-2">
                                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                            </div>
                            <h6 class="fw-bold text-dark mb-1">Flock Health Normal</h6>
                            <p class="small text-muted mb-0">No abnormal mortality spikes or threshold breaches detected in the last 7 days.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Upcoming Milestones -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <span class="p-1 rounded bg-primary-subtle text-primary">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        </span>
                        <h2 class="h6 fw-bold mb-0">Broiler Lifecycle Milestones</h2>
                    </div>
                    <span class="badge bg-light text-dark border">Vaccines & Feed Transitions</span>
                </div>
                <div class="card-body p-3">
                    @if (s.UpcomingMilestones.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var m in s.UpcomingMilestones)
                            {
                                <div class="list-group-item px-0 py-2 border-0 d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge @(m.IsDueToday ? "bg-warning text-dark" : "bg-primary-subtle text-primary")">Day @m.TargetDay</span>
                                            <strong class="small text-dark">@m.MilestoneTitle</strong>
                                        </div>
                                        <p class="small text-muted mb-0 mt-1">@m.Description (Flock @m.BatchCode, Age: @m.CurrentAgeDays d)</p>
                                    </div>
                                    @if (m.IsDueToday)
                                    {
                                        <span class="badge bg-danger text-white">DUE TODAY</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="small text-muted text-center py-4 mb-0">No active milestones within the current 7-day window.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Active Flock Batches Performance Table -->
    <div class="card border-0 shadow-sm rounded-3 bg-white mb-4">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h2 class="h6 fw-bold mb-0">Active Flock Production Batches</h2>
            <span class="small text-muted">Pure Domain KPI Calculations (FCR, ADG, EPEF)</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Batch Code</th>
                        <th>Farm / House</th>
                        <th>Breed</th>
                        <th>Age</th>
                        <th>Live Birds</th>
                        <th>FCR</th>
                        <th>ADG (g/d)</th>
                        <th>Mortality %</th>
                        <th>EPEF</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!s.Batches.Any())
                    {
                        <tr>
                            <td colspan="11" class="text-center py-5">
                                <div class="mb-2" style="font-size: 2.2rem;">🐣</div>
                                <h6 class="fw-bold text-dark mb-1">No Active Flock Batches Recorded Yet</h6>
                                <p class="text-muted small mb-3">You have not placed any flock batches in your sheds yet. Add your chicks to automatically calculate FCR, ADG, and mortality.</p>
                                <a asp-page="/Farmer/Batches" class="btn btn-sm btn-primary px-3">+ Place Your First Flock Batch</a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var b in s.Batches)
                    {
                        <tr>
                            <td class="ps-3 fw-bold text-primary">@b.BatchCode</td>
                            <td>@b.FarmName <span class="text-muted small">(@b.HouseName)</span></td>
                            <td><span class="badge bg-light text-dark border">@b.BreedName</span></td>
                            <td><strong>@b.AgeDays</strong> d</td>
                            <td>@b.CurrentAliveCount.ToString("N0") <span class="text-muted small">/ @b.InitialChickCount.ToString("N0")</span></td>
                            <td>
                                @if (b.LatestFcr.HasValue)
                                {
                                    <strong class="@(b.LatestFcr < 1.65m ? "text-success" : "text-warning-emphasis")">@b.LatestFcr.Value.ToString("F2")</strong>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @(b.LatestAvgWeightGrams.HasValue && b.AgeDays > 0 ? (b.LatestAvgWeightGrams.Value / b.AgeDays).ToString("F1") : "—")
                            </td>
                            <td>
                                <span class="@(b.MortalityRatePct > 5m ? "text-danger fw-bold" : "text-dark")">@b.MortalityRatePct?.ToString("F1")%</span>
                            </td>
                            <td>
                                @if (b.LatestFcr.HasValue && b.AgeDays > 0 && b.LatestAvgWeightGrams.HasValue)
                                {
                                    var survival = b.InitialChickCount > 0 ? ((decimal)b.CurrentAliveCount / b.InitialChickCount) * 100m : 0m;
                                    var avgKg = b.LatestAvgWeightGrams.Value / 1000m;
                                    var epef = (survival * avgKg) / (b.AgeDays * b.LatestFcr.Value) * 100m;
                                    <span class="badge bg-info-subtle text-info-emphasis">@epef.ToString("F0")</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(b.Status == AERIE.Domain.Enums.BatchStatus.ReadyForSale ? "bg-success text-white" : "bg-primary-subtle text-primary")">
                                    @b.Status
                                </span>
                            </td>
                            <td class="text-end pe-3">
                                <a asp-page="/Farmer/Batches" class="btn btn-sm btn-outline-secondary">Details</a>
                            </td>
                        </tr>
                    }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Recent Daily Observations Log -->
    <div class="card border-0 shadow-sm rounded-3 bg-white">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h2 class="h6 fw-bold mb-0">Recent Daily Farm Observations</h2>
            <a asp-page="/Farmer/Batches" class="small text-decoration-none">View All in Batches &rarr;</a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Date</th>
                        <th>Opening</th>
                        <th>Mortality</th>
                        <th>Closing</th>
                        <th>Feed Category</th>
                        <th>Feed (kg)</th>
                        <th>Water (L)</th>
                        <th>Avg Weight (g)</th>
                        <th>Notes / Health</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!s.RecentDailyLogs.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted small">
                                <em>No daily observations recorded yet. When you log feed, water, and mortality, your daily performance log will appear here.</em>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in s.RecentDailyLogs)
                        {
                            <tr>
                                <td class="ps-3 fw-medium">@log.RecordDate.ToString("yyyy-MM-dd")</td>
                                <td>@log.OpeningCount.ToString("N0")</td>
                                <td>
                                    @if (log.DailyMortality > 0)
                                    {
                                        <span class="@(log.IsAbnormalMortality ? "badge bg-danger" : "text-danger fw-semibold")">
                                            @log.DailyMortality
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>
                                <td><strong class="text-primary">@log.ClosingCount.ToString("N0")</strong></td>
                                <td><span class="badge bg-light text-dark border">@log.FeedCategory</span></td>
                                <td>@log.FeedConsumedKg.ToString("F1")</td>
                                <td>@log.WaterConsumedLiters.ToString("F0")</td>
                                <td>@(log.AverageWeightGrams.HasValue ? $"{log.AverageWeightGrams:F0} g" : "—")</td>
                                <td class="small text-muted">
                                    @(string.IsNullOrEmpty(log.Notes) ? "—" : log.Notes)
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Quick Observation Modal -->
<div class="modal fade" id="quickLogModal" tabindex="-1" aria-labelledby="quickLogModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="RecordObservation">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="quickLogModalLabel">Log Daily Flock Observation</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Target Batch</label>
                        <select name="batchId" class="form-select" required>
                            @if (s?.Batches != null)
                            {
                                @foreach (var b in s.Batches.Where(x => x.Status == AERIE.Domain.Enums.BatchStatus.Active || x.Status == AERIE.Domain.Enums.BatchStatus.ReadyForSale))
                                {
                                    <option value="@b.Id">@b.BatchCode (@b.FarmName - @b.HouseName, Alive: @b.CurrentAliveCount)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Record Date</label>
                            <input type="date" name="recordDate" class="form-control" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Feed Phase</label>
                            <select name="feedCategory" class="form-select">
                                <option value="Starter">Starter (Day 1-14)</option>
                                <option value="Grower" selected>Grower (Day 15-28)</option>
                                <option value="Finisher">Finisher (Day 29+)</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-danger">Today's Mortality</label>
                            <input type="number" name="dailyMortality" class="form-control" value="0" min="0" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-primary">Closing Alive Count</label>
                            <input type="number" name="aliveCount" class="form-control" placeholder="Leave empty for auto-calc" />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Feed Consumed (kg)</label>
                            <input type="number" step="0.1" name="feedConsumedKg" class="form-control" placeholder="e.g. 450.5" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Water Consumed (L)</label>
                            <input type="number" step="1" name="waterConsumedLiters" class="form-control" placeholder="e.g. 900" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Sample Average Weight (grams) [Optional]</label>
                        <input type="number" step="1" name="averageWeightGrams" class="form-control" placeholder="e.g. 1950" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Field Observation Notes</label>
                        <textarea name="notes" class="form-control" rows="2" placeholder="Flock behavior, shed temperature, ventilation readings..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save & Calculate KPIs</button>
                </div>
            </form>
        </div>
    </div>
</div>
