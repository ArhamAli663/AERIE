@page
@model AERIE.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Select Portal - Farmer or Broker";
}

<div style="max-width: 1040px; margin: 1.5rem auto 3rem auto;">
    <!-- Hero / Role Question Section -->
    <div style="text-align: center; margin-bottom: 2.5rem;">
        <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: #eff6ff; color: #2563eb; padding: 0.4rem 1rem; border-radius: 9999px; font-size: 0.85rem; font-weight: 600; margin-bottom: 1rem; border: 1px solid #bfdbfe;">
            <span class="pulse-dot"></span>
            AERIE Multi-Tenant SaaS ERP Ecosystem
        </div>
        <h1 style="font-weight: 800; font-size: 2.4rem; letter-spacing: -0.75px; margin-bottom: 0.75rem; color: var(--color-text-main);">
            Select Your Role to Enter the Platform
        </h1>
        <p style="color: var(--color-text-muted); font-size: 1.1rem; max-width: 680px; margin: 0 auto;">
            AERIE enforces strict multi-tenant isolation. Please choose whether you are managing poultry farm production or trading as a commercial broker.
        </p>
    </div>

    <!-- Dual Role Selection Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); gap: 2rem; margin-bottom: 3rem;">
        <!-- Card 1: Farmer Portal -->
        <div class="panel-card" style="box-shadow: 0 10px 30px rgba(0,0,0,0.06); border-radius: 20px; padding: 2rem; border-top: 6px solid #10b981; display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.2s;">
            <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                    <div style="width: 56px; height: 56px; border-radius: 14px; background: #ecfdf5; color: #059669; display: flex; align-items: center; justify-content: center;">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                    </div>
                    <span class="badge badge-success" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">Production & Farms</span>
                </div>

                <h3 style="font-weight: 700; font-size: 1.45rem; margin-bottom: 0.5rem;">I am a Poultry Farmer</h3>
                <p style="color: var(--color-text-muted); font-size: 0.92rem; margin-bottom: 1.5rem;">
                    For poultry farm owners, shed managers, and production supervisors managing flock placement, daily feed, and sale listings.
                </p>

                <div style="background: var(--color-surface-hover); padding: 1.25rem; border-radius: var(--radius-md); margin-bottom: 1.5rem;">
                    <div style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--color-text-muted); margin-bottom: 0.75rem;">
                        Farmer Dedicated Capabilities:
                    </div>
                    <ul style="list-style: none; padding: 0; margin: 0; font-size: 0.88rem; display: flex; flex-direction: column; gap: 0.5rem;">
                        <li style="display: flex; align-items: center; gap: 0.5rem;">
                            <span style="color: #10b981;">✓</span> Farms & environment-controlled sheds tracking
                        </li>
                        <li style="display: flex; align-items: center; gap: 0.5rem;">
                            <span style="color: #10b981;">✓</span> Daily flock records: mortality, feed & water consumption
                        </li>
                        <li style="display: flex; align-items: center; gap: 0.5rem;">
                            <span style="color: #10b981;">✓</span> Automated calculations: FCR, ADG, and EPEF metrics
                        </li>
                        <li style="display: flex; align-items: center; gap: 0.5rem;">
                            <span style="color: #10b981;">✓</span> Publish ready-for-sale batches to B2B marketplace
                        </li>
                        <li style="display: flex; align-items: center; gap: 0.5rem;">
                            <span style="color: #10b981;">✓</span> Review and accept/reject incoming broker purchase bids
                        </li>
                    </ul>
                </div>
            </div>

            <div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem;">
                    <a asp-page="/Auth/Login" asp-route-role="Farmer" class="btn-stitch-primary" style="justify-content: center; padding: 0.65rem;">
                        Farmer Login
                    </a>
                    <a asp-page="/Auth/Register" asp-route-role="Farmer" class="btn-stitch-secondary" style="justify-content: center; padding: 0.65rem;">
                        Farmer Sign Up
                    </a>
                </div>

                <form method="post" asp-page-handler="QuickDemo">
                    <input type="hidden" name="role" value="Farmer" />
                    <button type="submit" class="btn-stitch-secondary" style="width: 100%; justify-content: center; font-size: 0.85rem; padding: 0.6rem; background: #f0fdf4; border-color: #bbf7d0; color: #166534;">
                        ⚡ 1-Click Demo Login as Al-Madina Farms
                    </button>
                </form>
            </div>
        </div>

        <!-- Card 2: Broker Portal -->
        <div class="panel-card" style="box-shadow: 0 10px 30px rgba(0,0,0,0.06); border-radius: 20px; padding: 2rem; border-top: 6px solid #0284c7; display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.2s;">
            <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                    <div style="width: 56px; height: 56px; border-radius: 14px; background: #e0f2fe; color: #0284c7; display: flex; align-items: center; justify-content: center;">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                    </div>
                    <span class="badge badge-primary" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">Trading & Logistics</span>
                </div>

                <h3 style="font-weight: 700; font-size: 1.45rem; margin-bottom: 0.5rem;">I am a Poultry Broker</h3>
                <p style="color: var(--color-text-muted); font-size: 0.92rem; margin-bottom: 1.5rem;">
                    For poultry traders, mandi commission agents, and logistics operators discovering batches, bidding, and managing settlements.
                </p>

                <div style="background: var(--color-surface-hover); padding: 1.25rem; border-radius: var(--radius-md); margin-bottom: 1.5rem;">
                    <div style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--color-text-muted); margin-bottom: 0.75rem;">
                        Broker Dedicated Capabilities:
                    </div>
                    <ul style="list-style: none; padding: 0; margin: 0; font-size: 0.88rem; display: flex; flex-direction: column; gap: 0.5rem;">
                        <li style="display: flex; align-items: center; gap: 0.5rem;">
                            <span style="color: #0284c7;">✓</span> Browse live ready broiler batches across regions
                        </li>
                        <li style="display: flex; align-items: center; gap: 0.5rem;">
                            <span style="color: #0284c7;">✓</span> Submit purchase bids & negotiate deal proposals
                        </li>
                        <li style="display: flex; align-items: center; gap: 0.5rem;">
                            <span style="color: #0284c7;">✓</span> Farm weighbridge lifting tickets & truck logistics
                        </li>
                        <li style="display: flex; align-items: center; gap: 0.5rem;">
                            <span style="color: #0284c7;">✓</span> Destination delivery, transit shrinkage & bird loss deduction
                        </li>
                        <li style="display: flex; align-items: center; gap: 0.5rem;">
                            <span style="color: #0284c7;">✓</span> Automated commission engine & double-entry financial ledger
                        </li>
                    </ul>
                </div>
            </div>

            <div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem;">
                    <a asp-page="/Auth/Login" asp-route-role="Broker" class="btn-stitch-primary" style="justify-content: center; padding: 0.65rem;">
                        Broker Login
                    </a>
                    <a asp-page="/Auth/Register" asp-route-role="Broker" class="btn-stitch-secondary" style="justify-content: center; padding: 0.65rem;">
                        Broker Sign Up
                    </a>
                </div>

                <form method="post" asp-page-handler="QuickDemo">
                    <input type="hidden" name="role" value="Broker" />
                    <button type="submit" class="btn-stitch-secondary" style="width: 100%; justify-content: center; font-size: 0.85rem; padding: 0.6rem; background: #f0f9ff; border-color: #bae6fd; color: #0369a1;">
                        ⚡ 1-Click Demo Login as Punjab Poultry Traders
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Live Market Rates Section (Accessible To Both Roles) -->
    <div class="panel-card" style="box-shadow: 0 4px 20px rgba(0,0,0,0.04); border-radius: 16px; padding: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
            <div>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <span class="pulse-dot"></span>
                    <h3 class="panel-title" style="margin: 0; font-size: 1.15rem;">Official Daily Mandi Rates (Live)</h3>
                </div>
                <p style="color: var(--color-text-muted); font-size: 0.85rem; margin: 0.25rem 0 0 0;">
                    Shared market intelligence broadcast in real-time across Pakistan. Accessible to all Farmers & Brokers.
                </p>
            </div>
            <div style="display: flex; gap: 0.5rem;">
                <a asp-page="/PoultryShops" class="btn-stitch-secondary" style="font-size: 0.85rem; padding: 0.45rem 0.9rem; text-decoration: none;">
                    🏬 Poultry Shops Directory →
                </a>
                <a asp-page="/MarketRates" class="btn-stitch-primary" style="font-size: 0.85rem; padding: 0.45rem 0.9rem; text-decoration: none;">
                    📈 All Pakistan Mandi Rates →
                </a>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
            <div style="background: var(--color-surface-hover); padding: 1rem; border-radius: var(--radius-md); border-left: 4px solid var(--color-primary);">
                <div style="font-size: 0.8rem; font-weight: 600; color: var(--color-text-muted);">LAHORE DIVISION</div>
                <div style="font-size: 1.45rem; font-weight: 700; margin: 0.25rem 0;">Rs. 345 / kg</div>
                <div style="font-size: 0.75rem; color: #16a34a; font-weight: 600;">▲ +Rs. 5 today</div>
            </div>
            <div style="background: var(--color-surface-hover); padding: 1rem; border-radius: var(--radius-md); border-left: 4px solid var(--color-primary);">
                <div style="font-size: 0.8rem; font-weight: 600; color: var(--color-text-muted);">FAISALABAD</div>
                <div style="font-size: 1.45rem; font-weight: 700; margin: 0.25rem 0;">Rs. 340 / kg</div>
                <div style="font-size: 0.75rem; color: var(--color-text-muted);">Steady</div>
            </div>
            <div style="background: var(--color-surface-hover); padding: 1rem; border-radius: var(--radius-md); border-left: 4px solid var(--color-primary);">
                <div style="font-size: 0.8rem; font-weight: 600; color: var(--color-text-muted);">RAWALPINDI / ISL</div>
                <div style="font-size: 1.45rem; font-weight: 700; margin: 0.25rem 0;">Rs. 352 / kg</div>
                <div style="font-size: 0.75rem; color: #16a34a; font-weight: 600;">▲ +Rs. 7 today</div>
            </div>
            <div style="background: var(--color-surface-hover); padding: 1rem; border-radius: var(--radius-md); border-left: 4px solid var(--color-primary);">
                <div style="font-size: 0.8rem; font-weight: 600; color: var(--color-text-muted);">MULTAN</div>
                <div style="font-size: 1.45rem; font-weight: 700; margin: 0.25rem 0;">Rs. 338 / kg</div>
                <div style="font-size: 0.75rem; color: #dc2626; font-weight: 600;">▼ -Rs. 2 today</div>
            </div>
        </div>
    </div>
</div>
